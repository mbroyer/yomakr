# Caddy holt sich automatisch ein HTTPS-Zertifikat (Let's Encrypt) für die Domain.
{$YOMAKR_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}
	reverse_proxy yomakr:3000
}
