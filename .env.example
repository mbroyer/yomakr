# API-Key aus der Anthropic Console (eigener Key nur für Yomakr, mit Monatslimit)
ANTHROPIC_API_KEY=

# Zugang für das Kind (kurze PIN, gut auf dem iPad zu tippen)
KID_PIN=1234
# Zugang für den Elternbereich (langes Passwort!)
PARENT_PASSWORD=

# Zufälliger langer Wert zum Signieren der Login-Cookies, z. B. `openssl rand -hex 32`
SESSION_SECRET=

# Name des Kindes, damit Claude es ansprechen kann (optional)
KID_NAME=

# Modelle (optional). Chat: Claude Opus 5.5, Prüfschritt: Claude Haiku 5.5
CHAT_MODEL=claude-opus-5-5
CHECK_MODEL=claude-haiku-5-5

# Speicherort der Datenbank
DATABASE_PATH=./data/yomakr.db
