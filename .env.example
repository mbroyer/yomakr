# Adresse, unter der Yomakr erreichbar ist (nur für den Server mit Docker), z. B. yomakr.example.de
YOMAKR_DOMAIN=

# API-Key aus der Claude Console (eigener Key nur für Yomakr, mit Monatslimit)
ANTHROPIC_API_KEY=

# Zugang für das Kind (kurze PIN, gut auf dem iPad zu tippen)
KID_PIN=1234
# Zugang für den Elternbereich (langes Passwort!)
PARENT_PASSWORD=

# Zufälliger langer Wert zum Signieren der Login-Cookies, z. B. `openssl rand -hex 32`
SESSION_SECRET=

# Name des Kindes, damit Claude es ansprechen kann (optional)
KID_NAME=

# Modelle (optional). Chat: Claude Sonnet 5.5 (günstig), für mehr Tiefe claude-opus-5-5. Prüfschritt: Claude Haiku 5.5
CHAT_MODEL=claude-sonnet-5-5
CHECK_MODEL=claude-haiku-5-5

# Nur für den Test auf dem eigenen Rechner im WLAN ohne HTTPS: HEIMNETZ=1 setzt `npm run heimnetz` selbst.
# Auf dem Server nie setzen.

# Speicherort der Datenbank
DATABASE_PATH=./data/yomakr.db
